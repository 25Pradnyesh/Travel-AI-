# ==================================================
# Travel AI Mobile — Environment Configuration
# ==================================================

# Base URL for the Travel AI FastAPI backend engine.
# In local development:
#   - iOS Simulator / Web: http://localhost:8000
#   - Android Emulator:    http://10.0.2.2:8000
#   - Physical Device (LAN): http://<YOUR_LOCAL_IP>:8000
# In production (EAS / Release builds):
#   - Set to your hosted production FastAPI engine domain (HTTPS required).
#   - Example: https://api.travelai.example.com
EXPO_PUBLIC_API_URL=http://localhost:8000
