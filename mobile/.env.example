# ==================================================
# Travel AI Mobile — Environment Configuration
# ==================================================

# Base URL for the Travel AI FastAPI backend engine.
# In local development:
#   - iOS Simulator / Web: http://localhost:8000
#   - Android Emulator:    http://10.0.2.2:8000
#   - Physical Device (LAN): http://<YOUR_LOCAL_IP>:8000
# In production (EAS / Release builds):
#   - Set to your hosted production FastAPI engine domain (HTTPS required).
#   - Example: https://api.travelai.example.com
EXPO_PUBLIC_API_URL=http://localhost:8000

# ==================================================
# Supabase Cloud Database & Auth (Stage 1 V2)
# ==================================================

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public / Anonymous Client Key (Safe for client-side mobile use)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
# Alias supported by client:
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here

# NOTE: NEVER place a Supabase service_role key inside the mobile app!