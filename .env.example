# ==================================================
# Travel AI Engine — Environment Variables
# ==================================================

# Google Places API (Required for place resolution, place details, and nearby searches)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Google Gemini API (Optional — fallback scoring used if missing or unavailable)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenWeather API (Optional — travel intelligence weather enrichment)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# CORS Configuration (Optional — comma-separated allowed origins; defaults to localhost)
# Example: CORS_ORIGINS=https://your-frontend-domain.com,https://app.your-frontend-domain.com
CORS_ORIGINS=

# ==================================================
# Frontend (Next.js) Environment Variables
# ==================================================

# Travel AI Python Engine URL (Used by Next.js server-side API proxy)
ENGINE_API_URL=http://127.0.0.1:8000

# Client API URL prefix (Optional — defaults to empty for local relative routes like /api/analyze)
NEXT_PUBLIC_API_URL=
