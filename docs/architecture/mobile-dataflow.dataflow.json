  "flows": [
    {
      "from": "analyze_ui",
      "to": "travelai_svc",
      "label": "analyze(url)",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "place_ui",
      "to": "saved_svc",
      "label": "toggleBookmark()",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "travelai_svc",
      "to": "fastapi_engine",
      "label": "POST /analyze",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "saved_svc",
      "to": "async_storage",
      "label": "persistQueue",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "fastapi_engine",
      "to": "analysis_store",
      "label": "AnalysisResponse",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "async_storage",
      "to": "saved_cache",
      "label": "hydrate on mount",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "analysis_store",
      "to": "results_screen",
      "label": "destination dossier",
      "variant": "emphasis",
      "route": "straight"
    },
    {
      "from": "analysis_store",
      "to": "map_surface",
      "label": "POIs & coordinates",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "from": "saved_cache",
      "to": "saved_screen",
      "label": "offline bookmarks",
      "variant": "emphasis",
      "route": "vertical-channel"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Analysis Request Lifecycle",
      "items": [
        "180-second fetch timeout with AbortController for user-directed cancellation",
        "Active execution ref acts as mutex to prevent accidental duplicate requests",
        "Successful responses immediately populate analysisStore memory cache"
      ]
    },
    {
      "dot": "emerald",
      "title": "In-Memory Session Store",
      "items": [
        "analysisStore retains current AnalysisResponse and indexed Map of nearby POIs",
        "Enables O(1) place lookups when navigating to /place/[id] modal",
        "Session cache purges automatically when starting new analysis"
      ]
    },
    {
      "dot": "amber",
      "title": "Offline-Safe Persistence",
      "items": [
        "Serialized promise queue ensures atomic AsyncStorage write operations",
        "Guarantees consistency during rapid bookmark toggling without write races",
        "Places persist across app cold starts without server dependencies"
      ]
    }
  ]
}
