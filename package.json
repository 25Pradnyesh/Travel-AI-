{
  "name": "travel-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "mobile",
    "landing"
  ],
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix web",
    "lint": "npm run lint --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:lint": "npm run lint --prefix web",
    "landing:dev": "npm run dev --prefix landing",
    "landing:build": "npm run build --prefix landing",
    "landing:qr": "npm run qr --prefix landing",
    "mobile": "npm --workspace mobile run start",
    "mobile:start": "npm --workspace mobile run start",
    "mobile:android": "npm --workspace mobile run android",
    "mobile:ios": "npm --workspace mobile run ios"
  }
}
